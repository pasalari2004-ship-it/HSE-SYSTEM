generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HSE_MANAGER
  UNIT_MANAGER
}

model Company {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  address     String?
  logoUrl     String?
  field       String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  modules     CompanyModule[]
  personnel   Personnel[]
  accidents   Accident[]
  news        News[]
  guidelines  Guideline[]
  interviews  Interview[]
  accidentAnalyses AccidentAnalysis[]
  workHours   WorkHours[]
  risks       Risk[]
  fmeas       Fmea[]
  nonConformities NonConformity[] // 👈 اضافه شد

  @@map("companies")
}

model CompanyModule {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  moduleId    String
  subModuleId String?
  
  @@unique([companyId, moduleId, subModuleId])
  @@map("company_modules")
}

model User {
  id           Int             @id @default(autoincrement())
  username     String          @unique
  passwordHash String
  fullName     String
  role         Role
  companyId    Int?
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitName     String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  permissions  UserPermission[]
  auditLogs    AuditLog[]

  @@map("users")
}

model UserPermission {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  subModuleId String?
  
  @@unique([userId, moduleId, subModuleId])
  @@map("user_permissions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String?
  entityId   Int?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model Personnel {
  id                   Int      @id @default(autoincrement())
  companyId            Int?
  company              Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  personnelCode        String   @unique
  fullName             String
  nationalCode         String   @unique
  mobile               String?
  fatherName           String?
  issuePlace           String?
  birthDate            String?
  gender               String?
  maritalStatus        String?
  childrenCount        Int?
  education            String?
  age                  Int?
  height               Int?
  bloodPressure        String?
  diseaseType          String?
  physicalFactors      String?
  chemicalFactors      String?
  biologicalFactors    String?
  ergonomicFactors     String?
  psychologicalFactors String?
  hireDate             String?
  settlementDate       String?
  unit                 String?
  militaryStatus       String?
  exemptionType        String?
  workStation          String?
  position             String?
  assignedDuty         String?
  shiftType            String?
  shiftHours           String?
  medicalFileNumber    String?
  workConditions       String?
  medicalAdvice        String?
  workPhone            String?
  workAddress          String?
  postalCodeWorkplace  String?
  homePhone            String?
  homePostalCode       String?
  homeAddress          String?
  hseExpertOpinion     String?
  photoUrl             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  accidents            Accident[]

  @@map("personnel")
}

model Interview {
  id                   Int      @id @default(autoincrement())
  companyId            Int?
  company              Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  fullName             String
  position             String?
  birthDate            String?
  age                  Int?
  unit                 String?
  otherUnits           String?
  diseaseHistory       String?
  diseaseNotes         String?
  accidentHistory      String?
  accidentNotes        String?
  safetyKnowledge      String?
  hseCourses           String?
  hseCoursesNotes      String?
  sportsHistory        String?
  sportsNotes          String?
  physicalFitness      String?
  smokingHistory       String?
  smokingNotes         String?
  fileStatus           String?
  lastTestDate         String?
  healthStatus         String?
  height               Int?
  weight               Int?
  bmi                  String?
  militaryStatus       String?
  serviceField         String?
  exemptionType        String?
  hseOpinion           String?
  notes                String?
  interviewerName      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("interviews")
}

model Guideline {
  id              Int      @id @default(autoincrement())
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  title           String
  documentCode    String?
  version         String?
  category        String   @default("دستورالعمل")
  processOwner    String?
  approvalDate    String?
  reviewDate      String?
  description     String?
  content         String?  @db.Text
  fileUrl         String?
  status          String   @default("فعال")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("guidelines")
}

model Accident {
  id                    Int         @id @default(autoincrement())
  companyId             Int?
  company               Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  accidentCode          String?     @unique
  personnelCode         String?
  personnel             Personnel?  @relation(fields: [personnelCode], references: [personnelCode])
  victimName            String
  birthDate             String?
  hireDate              String?
  job                   String?
  workExperience        String?
  education             String?
  maritalStatus         String?
  workLocation          String?
  accidentDate          String?
  accidentTime          String?
  exactLocation         String?
  injuredArea           String?
  description           String?     @db.Text
  result                String?     @db.Text
  cause                 String?     @db.Text
  hasTraining           String?
  hasPPE                String?
  witnesses             String?     @db.Text
  supervisorReport      String?     @db.Text
  supervisorName        String?
  medicalActions        String?     @db.Text
  outpatientTreatment   String?
  hospitalReferral      String?
  otherMedical          String?
  sickLeaveDays         Int?
  lostWorkHours         String?
  medicalNotes          String?     @db.Text
  status                String      @default("باز")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  analysis              AccidentAnalysis?

  @@map("accidents")
}

model News {
  id           Int      @id @default(autoincrement())
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  title        String
  content      String   @db.Text
  source       String?
  imageUrl     String?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("news")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model AccidentAnalysis {
  id                   Int      @id @default(autoincrement())
  companyId            Int?
  company              Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  accidentId           Int      @unique
  accident             Accident @relation(fields: [accidentId], references: [id], onDelete: Cascade)
  
  introduction         String?  @db.Text
  directCause          String?  @db.Text
  indirectCause        String?  @db.Text
  basicCause           String?  @db.Text
  rootCause            String?  @db.Text
  
  existingControls     String?  @db.Text
  witnessStatement     String?  @db.Text
  
  managerName          String?
  managerDate          String?
  managerSignature     String?
  
  unitManagerName      String?
  unitManagerDate      String?
  unitManagerSignature String?
  
  hseRecommendations   String? @db.Text
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("accident_analyses")
}

model WorkHours {
  id           Int      @id @default(autoincrement())
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  year         Int
  month        Int
  totalHours   Int      @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, year, month])
  @@map("work_hours")
}

model Risk {
  id              Int      @id @default(autoincrement())
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  title           String
  description     String?  @db.Text
  location        String?  
  activity        String?  
  
  probability     Int      @default(1) 
  severity        Int      @default(1) 
  riskLevel       Int      @default(1) 
  
  controlMeasures String?  @db.Text 
  responsible     String?  
  deadline        String?  
  
  status          String   @default("باز") 
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("risks")
}

model Fmea {
  id                Int      @id @default(autoincrement())
  companyId         Int?
  company           Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  processName       String
  failureMode       String
  failureEffect     String?  @db.Text
  failureCause      String?  @db.Text
  currentControls   String?  @db.Text
  
  severity          Int      @default(1)
  occurrence        Int      @default(1)
  detection         Int      @default(1)
  rpn               Int      @default(1)
  
  rpl               String?  @default("کم اهمیت")
  strategy          String?  @default("کاهش ریسک")
  
  recommendedAction String?  @db.Text
  responsible       String?
  deadline          String?
  
  newSeverity       Int?
  newOccurrence     Int?
  newDetection      Int?
  newRpn            Int?
  
  status            String   @default("باز")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("fmeas")
}

model NonConformity {
  id                Int      @id @default(autoincrement())
  companyId         Int?
  company           Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  reportNumber      String?  // شماره گزارش (P-31)
  reportDate        String?  // تاریخ گزارش
  
  factoryName       String?  // نام کارخانه/انبار
  unitName          String?  // نام واحد
  stationName       String?  // نام ایستگاه کار
  
  source            String?  // برگرفته از (ایمنی، بهداشتی، زیست محیطی)
  ncType            String?  // نوع عدم انطباق (ثبت در ارزیابی ریسک، شرایط ناایمن، رفتار ناایمن)
  
  hazardDescription String?  @db.Text // شرح خطر/عدم انطباق
  cause             String?  @db.Text // علت/علل خطر
  consequence       String?  @db.Text // پیامد
  legalRequirement  String?  @db.Text // الزام قانونی
  hseAction         String?  @db.Text // اقدام پیشنهادی HSE
  
  severity          Int      @default(1) // شدت (1-5)
  probability       Int      @default(1) // احتمال (1-5)
  detection         Int      @default(1) // کشف (1-5)
  rpl               String?  // سطح ریسک (قابل تحمل / غیرقابل تحمل)
  
  action1Responsible String? // مسئول اقدام ۱
  action1Deadline    String? // مهلت اقدام ۱
  action2Responsible String? // مسئول اقدام ۲
  action2Deadline    String? // مهلت اقدام ۲
  
  actionReport      String?  @db.Text // گزارش مسئول اقدام اجرایی
  managerAction     String?  @db.Text // شرح اقدام مصوب مدیر
  effectiveness     String?  @db.Text // گزارش پیگیری و اجرا
  
  followUpName      String?  // نام مسئول پیگیری
  
  status            String   @default("باز") 
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("non_conformities")
}