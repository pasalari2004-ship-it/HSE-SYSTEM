generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HSE_MANAGER
  UNIT_MANAGER
}

model Company {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  address     String?
  logoUrl     String?
  field       String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  modules     CompanyModule[]
  personnel   Personnel[]
  accidents   Accident[]
  news        News[]
  guidelines  Guideline[]
  interviews  Interview[]  // 👈 این خط اضافه شد

  @@map("companies")
}

model CompanyModule {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  moduleId    String
  
  @@unique([companyId, moduleId])
  @@map("company_modules")
}

model User {
  id           Int             @id @default(autoincrement())
  username     String          @unique
  passwordHash String
  fullName     String
  role         Role
  companyId    Int?
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitName     String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  permissions  UserPermission[]
  auditLogs    AuditLog[]

  @@map("users")
}

model UserPermission {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId   String
  
  @@unique([userId, moduleId])
  @@map("user_permissions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String?
  entityId   Int?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model Personnel {
  id                   Int      @id @default(autoincrement())
  companyId            Int?
  company              Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  personnelCode        String   @unique
  fullName             String
  nationalCode         String   @unique
  mobile               String?
  fatherName           String?
  issuePlace           String?
  birthDate            String?
  gender               String?
  maritalStatus        String?
  childrenCount        Int?
  education            String?
  age                  Int?
  height               Int?
  bloodPressure        String?
  diseaseType          String?
  physicalFactors      String?
  chemicalFactors      String?
  biologicalFactors    String?
  ergonomicFactors     String?
  psychologicalFactors String?
  hireDate             String?
  settlementDate       String?
  unit                 String?
  militaryStatus       String?
  exemptionType        String?
  workStation          String?
  position             String?
  assignedDuty         String?
  shiftType            String?
  shiftHours           String?
  medicalFileNumber    String?
  workConditions       String?
  medicalAdvice        String?
  workPhone            String?
  workAddress          String?
  postalCodeWorkplace  String?
  homePhone            String?
  homePostalCode       String?
  homeAddress          String?
  hseExpertOpinion     String?
  photoUrl             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  accidents            Accident[]

  @@map("personnel")
}

model Interview {
  id                   Int      @id @default(autoincrement())
  companyId            Int?  // 👈 اضافه شد
  company              Company? @relation(fields: [companyId], references: [id], onDelete: Cascade) // 👈 اضافه شد
  
  fullName             String
  position             String?
  birthDate            String?
  age                  Int?
  unit                 String?
  otherUnits           String?
  diseaseHistory       String?
  diseaseNotes         String?
  accidentHistory      String?
  accidentNotes        String?
  safetyKnowledge      String?
  hseCourses           String?
  hseCoursesNotes      String?
  sportsHistory        String?
  sportsNotes          String?
  physicalFitness      String?
  smokingHistory       String?
  smokingNotes         String?
  fileStatus           String?
  lastTestDate         String?
  healthStatus         String?
  height               Int?
  weight               Int?
  bmi                  String?
  militaryStatus       String?
  serviceField         String?
  exemptionType        String?
  hseOpinion           String?
  notes                String?
  interviewerName      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("interviews")
}

model Guideline {
  id              Int      @id @default(autoincrement())
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  title           String
  documentCode    String?
  version         String?
  category        String   @default("دستورالعمل")
  processOwner    String?
  approvalDate    String?
  reviewDate      String?
  description     String?
  content         String?  @db.Text
  fileUrl         String?
  status          String   @default("فعال")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("guidelines")
}

model Accident {
  id                    Int         @id @default(autoincrement())
  companyId             Int?
  company               Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  accidentCode          String?     @unique
  personnelCode         String?
  personnel             Personnel?  @relation(fields: [personnelCode], references: [personnelCode])
  victimName            String
  birthDate             String?
  hireDate              String?
  job                   String?
  workExperience        String?
  education             String?
  maritalStatus         String?
  workLocation          String?
  accidentDate          String?
  accidentTime          String?
  exactLocation         String?
  injuredArea           String?
  description           String?     @db.Text
  result                String?     @db.Text
  cause                 String?     @db.Text
  hasTraining           String?
  hasPPE                String?
  witnesses             String?     @db.Text
  supervisorReport      String?     @db.Text
  supervisorName        String?
  medicalActions        String?     @db.Text
  outpatientTreatment   String?
  hospitalReferral      String?
  otherMedical          String?
  sickLeaveDays         Int?
  lostWorkHours         String?
  medicalNotes          String?     @db.Text
  status                String      @default("باز")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("accidents")
}

model News {
  id           Int      @id @default(autoincrement())
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  title        String
  content      String   @db.Text
  source       String?
  imageUrl     String?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("news")
}