generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Personnel {
  id                   Int      @id @default(autoincrement())
  personnelCode        String   @unique
  fullName             String
  nationalCode         String   @unique
  mobile               String?
  fatherName           String?
  issuePlace           String?
  birthDate            String?
  gender               String?
  maritalStatus        String?
  childrenCount        Int?
  education            String?
  age                  Int?
  height               Int?
  bloodPressure        String?
  diseaseType          String?
  physicalFactors      String?
  chemicalFactors      String?
  biologicalFactors    String?
  ergonomicFactors     String?
  psychologicalFactors String?
  hireDate             String?
  settlementDate       String?
  unit                 String?
  militaryStatus       String?
  exemptionType        String?
  workStation          String?
  position             String?
  assignedDuty         String?
  shiftType            String?
  shiftHours           String?
  medicalFileNumber    String?
  workConditions       String?
  medicalAdvice        String?
  workPhone            String?
  workAddress          String?
  postalCodeWorkplace  String?
  homePhone            String?
  homePostalCode       String?
  homeAddress          String?
  hseExpertOpinion     String?
  photoUrl             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  accidents            Accident[]

  @@map("personnel")
}

model Interview {
  id                   Int      @id @default(autoincrement())
  fullName             String
  position             String?
  birthDate            String?
  age                  Int?
  unit                 String?
  otherUnits           String?
  diseaseHistory       String?
  diseaseNotes         String?
  accidentHistory      String?
  accidentNotes        String?
  safetyKnowledge      String?
  hseCourses           String?
  hseCoursesNotes      String?
  sportsHistory        String?
  sportsNotes          String?
  physicalFitness      String?
  smokingHistory       String?
  smokingNotes         String?
  fileStatus           String?
  lastTestDate         String?
  healthStatus         String?
  height               Int?
  weight               Int?
  bmi                  String?
  militaryStatus       String?
  serviceField         String?
  exemptionType        String?
  hseOpinion           String?
  notes                String?
  interviewerName      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("interviews")
}

model Guideline {
  id              Int      @id @default(autoincrement())
  title           String
  documentCode    String?
  version         String?
  category        String   @default("دستورالعمل")
  processOwner    String?
  approvalDate    String?
  reviewDate      String?
  description     String?
  content         String?  @db.Text
  fileUrl         String?
  status          String   @default("فعال")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("guidelines")
}

model Accident {
  id                    Int         @id @default(autoincrement())
  accidentCode          String?     @unique

  personnelCode         String?
  personnel             Personnel?  @relation(fields: [personnelCode], references: [personnelCode])

  victimName            String
  birthDate             String?
  hireDate              String?
  job                   String?
  workExperience        String?
  education             String?
  maritalStatus         String?
  workLocation          String?

  accidentDate          String?
  accidentTime          String?
  exactLocation         String?

  injuredArea           String?

  description           String?     @db.Text
  result                String?     @db.Text
  cause                 String?     @db.Text

  hasTraining           String?
  hasPPE                String?

  witnesses             String?     @db.Text

  supervisorReport      String?     @db.Text
  supervisorName        String?

  medicalActions        String?     @db.Text
  outpatientTreatment   String?
  hospitalReferral      String?
  otherMedical          String?
  sickLeaveDays         Int?
  lostWorkHours         String?
  medicalNotes          String?     @db.Text

  status                String      @default("باز")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("accidents")
}

model News {
  id           Int      @id @default(autoincrement())
  title        String
  content      String   @db.Text
  source       String?
  imageUrl     String?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("news")
}